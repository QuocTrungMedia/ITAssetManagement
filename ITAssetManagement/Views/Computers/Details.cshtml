@model ITAssetManagement.Models.Computer

@{
    ViewData["Title"] = "Chi tiết máy tính";
}

<div class="manage-page">
    <div class="manage-header">
        <p class="eyebrow">MÁY TÍNH</p>
        <h1>Chi tiết máy tính</h1>
        <p class="text-secondary mb-0">
            Thông tin thiết bị và người đang sử dụng.
        </p>
    </div>

    <div class="manage-card">
        <div class="details-grid">
            <div class="detail-box">
                <span class="detail-label">Mã máy tính</span>
                <span class="detail-value">#@Model.ComputerID</span>
            </div>

            <div class="detail-box">
                <span class="detail-label">Tên máy tính</span>
                <span class="detail-value">@Model.ComputerName</span>
            </div>

            <div class="detail-box">
                <span class="detail-label">Hệ điều hành</span>
                <span class="detail-value">
                    @(Model.OperatingSystem ?? "Chưa cập nhật")
                </span>
            </div>

            <div class="detail-box">
                <span class="detail-label">Trạng thái</span>

                @if (Model.Status == "Active")
                {
                    <span class="badge bg-success">Hoạt động</span>
                }
                else
                {
                    <span class="badge bg-danger">Không hoạt động</span>
                }
            </div>

            <div class="detail-box form-group-full">
                <span class="detail-label">Nhân viên sử dụng</span>
                <span class="detail-value">
                    @(Model.Employee?.FullName ?? "Chưa cấp phát")
                </span>
            </div>
        </div>

        <div class="form-actions">
            <a asp-action="Edit"
               asp-route-id="@Model.ComputerID"
               class="btn btn-warning">
                Sửa thông tin
            </a>

            <a asp-action="Index" class="btn btn-light border">
                Quay lại
            </a>
        </div>
    </div>
</div>