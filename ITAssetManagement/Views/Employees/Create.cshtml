@model ITAssetManagement.Models.Employee

@{
    ViewData["Title"] = "Thêm nhân viên";
}

<div class="manage-page">
    <div class="manage-header">
        <p class="eyebrow">NHÂN VIÊN</p>
        <h1>Thêm nhân viên</h1>
        <p class="text-secondary mb-0">
            Nhập thông tin nhân viên mới vào hệ thống.
        </p>
    </div>

    <div class="manage-card">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger"></div>

            <div class="form-grid">
                <div class="form-group-full">
                    <label asp-for="FullName" class="form-label"></label>
                    <input asp-for="FullName"
                           class="form-control"
                           placeholder="Ví dụ: Nguyễn Văn An" />
                    <span asp-validation-for="FullName"></span>
                </div>

                <div>
                    <label asp-for="Department" class="form-label"></label>
                    <input asp-for="Department"
                           class="form-control"
                           placeholder="Ví dụ: Phòng IT" />
                    <span asp-validation-for="Department"></span>
                </div>

                <div>
                    <label asp-for="Phone" class="form-label"></label>
                    <input asp-for="Phone"
                           class="form-control"
                           placeholder="Ví dụ: 0123456789" />
                    <span asp-validation-for="Phone"></span>
                </div>

                <div class="form-group-full">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email"
                           class="form-control"
                           placeholder="Ví dụ: nhanvien@gmail.com" />
                    <span asp-validation-for="Email"></span>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">
                    Thêm nhân viên
                </button>

                <a asp-action="Index" class="btn btn-light border">
                    Quay lại
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}